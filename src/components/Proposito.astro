---
import { PROPOSITO, VALORES } from '../data/home';
---
<section id="proposito" class="proposito section" aria-labelledby="proposito-titulo">
  <div class="wrap">
    <div class="proposito__head">
      <div data-reveal>
        <p class="eyebrow">{PROPOSITO.eyebrow}</p>
        <h2 id="proposito-titulo" class="h2">{PROPOSITO.title}</h2>
      </div>
      <p class="lead" data-reveal style="--d: 1">{PROPOSITO.lead}</p>
    </div>

    <ul class="proposito__grid">
      {VALORES.map((v, i) => (
        <li class:list={['valor', `valor--${v.tone}`]} data-reveal style={`--d: ${i}`}>
          <span class="valor__n">{v.n}</span>
          <h3 class="valor__title">{v.titulo}</h3>
          <p class="valor__text">{v.texto}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .proposito {
    background: var(--surface);
  }
  .proposito__head {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 2rem 4rem;
    align-items: end;
  }
  .proposito__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .valor {
    display: flex;
    flex-direction: column;
    min-height: 19rem;
    padding: 1.6rem 1.6rem 1.8rem;
    border-radius: var(--radius);
  }
  .valor__n {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    margin-bottom: auto;
  }
  .valor__title {
    font-size: clamp(1.9rem, 2.6vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    margin-top: 2.5rem;
  }
  .valor__text {
    margin-top: 0.7rem;
    font-size: 1.0625rem;
    line-height: 1.5;
  }
  .valor--terracota { background: var(--terracota); color: #fff; }
  .valor--maiz { background: var(--maiz); color: var(--cacao); }
  .valor--jade { background: var(--jade); color: #fff; }
  .valor--cacao { background: var(--block); color: var(--on-block); }
  .valor--cacao .valor__n { color: var(--maiz); }

  @media (max-width: 960px) {
    .proposito__head { grid-template-columns: 1fr; }
    .proposito__grid { grid-template-columns: repeat(2, 1fr); }
    .valor { min-height: 15rem; }
  }
  @media (max-width: 560px) {
    .proposito__grid { grid-template-columns: 1fr; }
    .valor { min-height: 0; }
    .valor__title { margin-top: 1.75rem; }
  }
</style>
