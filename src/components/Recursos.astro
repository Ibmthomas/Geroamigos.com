---
import { Image } from 'astro:assets';
import fotoBanca from '../assets/img/conversacion-banca.jpg';
import { mailto } from '../config';
import { RECURSOS, RECURSOS_INTRO } from '../data/home';
---
<section id="recursos" class="recursos section" aria-labelledby="recursos-title">
  <div class="wrap">
    <div class="recursos__head">
      <p class="eyebrow">{RECURSOS_INTRO.eyebrow}</p>
      <h2 id="recursos-title" class="h2">{RECURSOS_INTRO.title}</h2>
      <p class="lead">{RECURSOS_INTRO.lead}</p>
    </div>

    <ul class="recursos__grid">
      <li class="card card--maiz">
        <svg class="card__circle" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="50" /></svg>
        <p class="card__tag">{RECURSOS.charla.tag}</p>
        <h3 class="card__title">{RECURSOS.charla.title}</h3>
      </li>

      <li class="card card--foto">
        <Image
          src={fotoBanca}
          alt="Dos hombres mayores conversan sentados en una banca"
          widths={[400, 600]}
          sizes="(max-width: 560px) 100vw, 300px"
        />
        <h3 class="card__title">{RECURSOS.conversar.title}</h3>
      </li>

      <li class="card card--cacao">
        <svg class="card__circle" viewBox="0 0 100 100" aria-hidden="true"><circle cx="50" cy="50" r="50" /></svg>
        <p class="card__tag">{RECURSOS.tendencias.tag}</p>
        <h3 class="card__title">{RECURSOS.tendencias.title}</h3>
      </li>

      <li class="card card--jade">
        <svg class="card__circles" viewBox="0 0 220 220" aria-hidden="true">
          <defs><clipPath id="rec-a"><circle cx="40" cy="40" r="100" /></clipPath></defs>
          <circle cx="40" cy="40" r="100" fill="#1C510F" />
          <circle cx="190" cy="130" r="90" fill="#1A2814" />
          <circle cx="190" cy="130" r="90" fill="#121A0C" clip-path="url(#rec-a)" />
        </svg>
        <p class="card__tag">{RECURSOS.residencias.tag}</p>
        <h3 class="card__title">{RECURSOS.residencias.title}</h3>
        <a class="btn btn--light card__btn" href={mailto(`${RECURSOS.residencias.title} · GeroAmigos`)}>
          {RECURSOS.residencias.cta}
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .recursos {
    background: var(--algodon);
  }
  .recursos__head {
    max-width: 44rem;
  }
  .recursos__head .lead {
    margin-top: 1.25rem;
  }
  .recursos__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: end;
    gap: 1.25rem;
    margin: clamp(2.5rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .card {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    aspect-ratio: 1 / 1.05;
    padding: 1.4rem;
    border-radius: var(--radius);
  }
  .card__tag {
    position: relative;
    margin-bottom: auto;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .card__title {
    position: relative;
    font-size: clamp(1.6rem, 2.3vw, 2.1rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.02;
  }
  .card__circle {
    position: absolute;
    width: 72%;
    right: -18%;
    bottom: -22%;
  }

  /* Círculo Terracota sobre Maíz: el cruce se resuelve en Fuego */
  .card--maiz { background: var(--maiz); color: var(--cacao); }
  .card--maiz .card__circle { fill: var(--fuego); width: 62%; right: -16%; bottom: auto; top: 18%; }

  .card--cacao { background: var(--cacao); color: var(--papel); }
  .card--cacao .card__tag { color: var(--maiz); }
  .card--cacao .card__circle { fill: var(--jade); width: 60%; right: -14%; bottom: auto; top: -14%; }

  .card--foto {
    padding: 0;
    background: var(--jade);
    color: #fff;
  }
  .card--foto :global(img) {
    width: 100%;
    flex: 1;
    min-height: 0;
    object-fit: cover;
  }
  .card--foto .card__title {
    padding: 1.1rem 1.4rem 1.3rem;
    font-size: clamp(1.35rem, 1.8vw, 1.6rem);
    line-height: 1.1;
  }

  .card--jade {
    aspect-ratio: 1 / 1.55;
    background: var(--jade);
    color: #fff;
  }
  .card--jade .card__circles {
    position: absolute;
    inset: 0 0 auto 0;
    width: 100%;
  }
  .card--jade .card__tag {
    margin-top: auto;
    margin-bottom: 0.9rem;
  }
  .card--jade .card__title {
    font-size: clamp(1.9rem, 2.6vw, 2.4rem);
  }
  .card__btn {
    position: relative;
    margin-top: 1.4rem;
    align-self: flex-start;
    font-size: 1.0625rem;
    min-height: 2.9rem;
  }

  @media (max-width: 1000px) {
    .recursos__grid { grid-template-columns: repeat(2, 1fr); align-items: stretch; }
    .card--jade { aspect-ratio: auto; }
  }
  @media (max-width: 560px) {
    .recursos__grid { grid-template-columns: 1fr; }
    .card { aspect-ratio: 4 / 3; }
    .card--foto { aspect-ratio: auto; }
    .card--foto :global(img) { aspect-ratio: 3 / 2; flex: none; }
    .card--jade { aspect-ratio: auto; min-height: 26rem; }
  }
</style>
