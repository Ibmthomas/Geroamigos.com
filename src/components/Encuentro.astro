---
// Banda "Encuentro": portada en Cacao con círculos que se cruzan.
---
<section class="encuentro" aria-labelledby="encuentro-title">
  <svg class="encuentro__circles" viewBox="0 0 600 400" preserveAspectRatio="xMaxYMax slice" aria-hidden="true">
    <defs>
      <clipPath id="enc-t"><circle cx="210" cy="420" r="190" /></clipPath>
    </defs>
    <circle cx="560" cy="20" r="120" fill="#1F7A73" />
    <circle cx="210" cy="420" r="190" fill="#D2532C" />
    <circle cx="440" cy="450" r="200" fill="#E8A922" />
    <circle cx="440" cy="450" r="200" fill="#BF3706" clip-path="url(#enc-t)" />
  </svg>

  <div class="wrap encuentro__inner">
    <p class="eyebrow">Nuestra mirada</p>
    <h2 id="encuentro-title" class="encuentro__title">Envejecer entre amigos</h2>
    <blockquote class="encuentro__quote">
      <p>“Envejecer también se aprende. Y se aprende mejor entre amigos.”</p>
    </blockquote>
  </div>
</section>

<style>
  .encuentro {
    position: relative;
    overflow: hidden;
    background: var(--cacao);
    color: var(--papel);
    padding-block: clamp(5rem, 12vw, 9rem);
  }
  .encuentro__circles {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(52%, 680px);
    height: 100%;
  }
  .encuentro__inner {
    position: relative;
  }
  .encuentro .eyebrow {
    color: var(--maiz);
  }
  .encuentro__title {
    font-size: clamp(3rem, 8.5vw, 7rem);
    max-width: 9ch;
    letter-spacing: -0.045em;
  }
  .encuentro__quote {
    margin: clamp(1.75rem, 3vw, 2.5rem) 0 0;
    max-width: 30ch;
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.4;
    color: var(--algodon);
  }

  @media (max-width: 760px) {
    .encuentro {
      padding-bottom: 14rem;
    }
    .encuentro__circles {
      width: 100%;
      height: 13rem;
      top: auto;
    }
  }
</style>
