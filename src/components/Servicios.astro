---
import Icon from './Icon.astro';
import { mailto } from '../config';
import { SERVICIOS as servicios, SERVICIOS_INTRO } from '../data/home';
---
<section id="servicios" class="servicios section" aria-labelledby="servicios-title">
  <div class="wrap">
    <div class="servicios__head" data-reveal>
      <p class="eyebrow">
        {SERVICIOS_INTRO.eyebrow}
        <span class="servicios__badge">{SERVICIOS_INTRO.badge}</span>
      </p>
      <h2 id="servicios-title" class="h2">{SERVICIOS_INTRO.title}</h2>
      <p class="lead">{SERVICIOS_INTRO.lead}</p>
      <a class="btn btn--ghost servicios__cta" href={mailto('Avísame cuando estén listos los servicios de GeroAmigos')}>
        <Icon name="correo" size={20} /> {SERVICIOS_INTRO.cta}
      </a>
    </div>

    <ul class="servicios__grid">
      {servicios.map((s, i) => (
        <li class="servicio" data-reveal style={`--d: ${i % 4}`}>
          <span class="servicio__pronto">Pronto</span>
          <span class:list={['servicio__icon', `servicio__icon--${s.tone}`]}>
            <Icon name={s.icon} size={34} />
          </span>
          <h3 class="servicio__title">{s.titulo}</h3>
          <p class="servicio__text">{s.texto}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .servicios__head {
    max-width: 44rem;
  }
  .servicios__head .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .servicios__badge {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--maiz);
    color: var(--cacao);
    letter-spacing: 0.08em;
  }
  .servicios__cta {
    margin-top: 1.75rem;
  }
  .servicio {
    position: relative;
  }
  .servicio__pronto {
    position: absolute;
    top: 0.25rem;
    left: 4.25rem;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    border: 1.5px dashed var(--line);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-soft);
    background: var(--bg);
  }
  @media (max-width: 520px) {
    .servicio__pronto {
      top: -0.5rem;
      left: 2.4rem;
      z-index: 1;
    }
  }
  .servicios__head .lead {
    margin-top: 1.25rem;
  }
  .servicios__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3rem 2rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .servicio__icon {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: 50%;
    transition: transform 0.25s;
  }
  .servicio:hover .servicio__icon {
    transform: scale(1.06) rotate(-4deg);
  }
  .servicio__icon--terracota { background: var(--terracota); color: var(--papel); }
  .servicio__icon--maiz { background: var(--maiz); color: var(--cacao); }
  .servicio__icon--jade { background: var(--jade); color: var(--papel); }
  .servicio__icon--cacao { background: var(--block); color: var(--on-block); }
  .servicio__title {
    margin-top: 1.25rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .servicio__text {
    margin-top: 0.55rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  @media (max-width: 1000px) {
    .servicios__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .servicios__grid { grid-template-columns: 1fr; gap: 2.25rem; }
    .servicio {
      display: grid;
      grid-template-columns: 4rem 1fr;
      column-gap: 1.1rem;
      align-items: start;
    }
    .servicio__icon { width: 4rem; height: 4rem; grid-row: span 2; }
    .servicio__icon :global(svg) { width: 28px; height: 28px; }
    .servicio__title { margin-top: 0.2rem; font-size: 1.35rem; }
  }
</style>
