---
import Icon from './Icon.astro';
import MapaLatam from './MapaLatam.astro';
import { HERO } from '../data/home';
import { PAISES } from '../data/paises';
---
<section class="hero" aria-labelledby="hero-title">
  <span class="hero__deco hero__deco--jade" aria-hidden="true"></span>
  <span class="hero__deco hero__deco--maiz" aria-hidden="true"></span>

  <div class="wrap hero__grid">
    <div class="hero__text">
      <p class="eyebrow">{HERO.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">
        {HERO.titleStart} <span>{HERO.titleAccent}</span>
      </h1>
      <p class="hero__lead">{HERO.lead}</p>
      <p class="hero__paises">
        <strong>{PAISES.length} países</strong>
        {PAISES.map((p) => p.nombre).join(' · ')}
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary" href="#paises">
          {HERO.ctaPrimary} <Icon name="abajo" size={20} />
        </a>
        <a class="btn btn--ghost" href="#contacto">{HERO.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero__mapa">
      <MapaLatam variant="hero" />
      <p class="hero__ayuda">{HERO.ayuda}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(3rem, 6vw, 4.5rem);
  }
  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero__title {
    font-size: clamp(2.6rem, 6vw, 5rem);
    letter-spacing: -0.045em;
  }
  .hero__title span {
    color: var(--terracota);
  }
  .hero__lead {
    max-width: 46ch;
    margin-top: 1.4rem;
    font-size: clamp(1.125rem, 1.6vw, 1.3125rem);
    color: var(--ink-soft);
  }
  .hero__paises {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .hero__paises strong {
    color: var(--accent-text);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .hero__mapa {
    position: relative;
    width: min(100%, 34rem);
    justify-self: center;
  }
  .hero__ayuda {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  /* Círculos decorativos de fondo (tintes planos, sin degradados) */
  .hero__deco {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }
  .hero__deco--jade {
    width: clamp(220px, 30vw, 440px);
    aspect-ratio: 1;
    right: calc(clamp(220px, 30vw, 440px) * -0.3);
    top: clamp(2rem, 6vw, 4rem);
    background: var(--jade-suave);
  }
  .hero__deco--maiz {
    width: clamp(220px, 28vw, 380px);
    aspect-ratio: 1;
    left: calc(clamp(220px, 28vw, 380px) * -0.35);
    bottom: calc(clamp(220px, 28vw, 380px) * -0.45);
    background: var(--maiz-suave);
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__mapa {
      width: min(100%, 26rem);
    }
  }
  @media (max-width: 700px) {
    .hero__deco--jade {
      width: 170px;
      right: -105px;
      top: 0.75rem;
    }
  }
  @media (max-width: 520px) {
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
