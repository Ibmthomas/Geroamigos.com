---
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource-variable/figtree/wght.css';
import '../styles/global.css';
import { SITE } from '../config';
import { PAISES } from '../data/paises';

interface Props {
  title?: string;
  description?: string;
  // Versión Markdown de la página para agentes; false si no tiene (p. ej. el 404)
  markdown?: string | false;
  noindex?: boolean;
}
const {
  title = `${SITE.name} · ${SITE.tagline}`,
  description = SITE.description,
  markdown = `${Astro.url.pathname.replace(/\/?$/, '/')}index.md`,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url);
const ogImage = new URL('/og-image.jpg', Astro.site ?? SITE.url);
const orgId = `${SITE.url}/#organization`;

// Datos estructurados: organización (contacto, dirección, logo, Instagram) y sitio web
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: SITE.name,
      url: SITE.url,
      logo: new URL('/logo.png', SITE.url).href,
      email: SITE.email,
      description: SITE.description,
      slogan: SITE.tagline,
      areaServed: [
        { '@type': 'Place', name: SITE.areaServed },
        ...PAISES.map((p) => ({ '@type': 'Country', name: p.nombre })),
      ],
      knowsLanguage: SITE.language,
      address: { '@type': 'PostalAddress', addressCountry: SITE.addressCountry },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          contactType: 'customer service',
          email: SITE.email,
          url: new URL('/contact/', SITE.url).href,
          availableLanguage: [SITE.language],
          areaServed: SITE.areaServed,
        },
      ],
      sameAs: [SITE.instagram],
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.url}/#website`,
      name: SITE.name,
      alternateName: 'Gero Amigos',
      url: SITE.url,
      inLanguage: SITE.language,
      publisher: { '@id': orgId },
    },
  ],
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FBF6EE" data-theme-color />
    <script is:inline>
      // Tema y tamaño de texto antes del primer pintado (sin parpadeo).
      // Sin elección guardada, el tema sigue la preferencia del sistema.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var theme = null, text = null;
        try { theme = localStorage.getItem('ga-theme'); text = localStorage.getItem('ga-text'); } catch (e) {}
        if (theme !== 'dark' && theme !== 'light') {
          theme = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        d.setAttribute('data-theme', theme);
        if (text === 'lg') d.setAttribute('data-text', 'lg');
        var meta = document.querySelector('meta[data-theme-color]');
        if (meta && theme === 'dark') meta.setAttribute('content', '#17110C');
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_419" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <slot />
    <script>
      // Aparición al hacer scroll de los elementos con [data-reveal]
      const elementos = document.querySelectorAll('[data-reveal]');
      const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!('IntersectionObserver' in window) || reducido) {
        elementos.forEach((el) => el.classList.add('is-visible'));
      } else {
        const observer = new IntersectionObserver(
          (entries) =>
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }),
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' },
        );
        elementos.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: 999px;
    background: var(--block);
    color: var(--on-block);
    font-weight: 700;
    text-decoration: none;
  }
  .skip:focus {
    top: 1rem;
  }
</style>
