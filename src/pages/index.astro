---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Trama from '../components/Trama.astro';
import Valores from '../components/Valores.astro';
import Servicios from '../components/Servicios.astro';
import Encuentro from '../components/Encuentro.astro';
import Nosotros from '../components/Nosotros.astro';
import Recursos from '../components/Recursos.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main id="contenido">
    <Hero />
    <Trama />
    <Valores />
    <Servicios />
    <Encuentro />
    <Nosotros />
    <Recursos />
    <Contacto />
  </main>
  <Footer />
</Base>
