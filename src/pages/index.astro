---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Trama from '../components/Trama.astro';
import Recorrido from '../components/Recorrido.astro';
import Proposito from '../components/Proposito.astro';
import Servicios from '../components/Servicios.astro';
import AmigosRed from '../components/AmigosRed.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---
<Base>
  <Header />
  <main id="contenido">
    <Hero />
    <Trama />
    <Recorrido />
    <Proposito />
    <Servicios />
    <AmigosRed />
    <Contacto />
  </main>
  <Footer />
</Base>
